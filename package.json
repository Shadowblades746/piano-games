{
  "name": "notereader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Piano sight-reading and ear-training practice suite",
  "scripts": {
    "build:css": "tailwindcss -i css/input.css -o css/styles.css --minify",
